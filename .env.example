# Copie este arquivo para .env na VM e preencha os valores reais.
#   cp .env.example .env && chmod 600 .env
# O .env nunca é versionado (está no .gitignore).

# Chave da API da Anthropic (console.anthropic.com) — único custo fora da OCI
ANTHROPIC_API_KEY=

# Modelo usado pelos 4 agentes
ANTHROPIC_MODEL=claude-sonnet-5

# Remetente aprovado no OCI Email Delivery e destinatário do post pronto
EMAIL_FROM=rennale.gregorio@lmforbusiness.com.br
EMAIL_TO=leandro.miranda@lmforbusiness.com.br

# SMTP do OCI Email Delivery (região sa-saopaulo-1)
# SMTP_USER e SMTP_PASS são as credenciais SMTP geradas no usuário do IAM
SMTP_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
